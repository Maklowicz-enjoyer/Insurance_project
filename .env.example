# ========================================
# SKANPOLIS - Environment Configuration
# ========================================
# IMPORTANT: Copy this file to .env and fill in the values
# NEVER commit .env file to git!
#
# To generate secure secrets:
#   openssl rand -base64 48
# ========================================

# ========================================
# Application Settings
# ========================================
APP_ENV=development
APP_DEBUG=true
APP_DOMAIN=localhost
APP_URL=http://localhost:8080

# ========================================
# Database Configuration
# ========================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=insurance_db
DB_USER=insurance_user
DB_PASSWORD=changeme_strong_password_here

# MySQL Root Password (for initial setup)
MYSQL_ROOT_PASSWORD=changeme_root_password_here

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password_here

# ========================================
# Session Security
# ========================================
# Generate with: openssl rand -base64 64
SESSION_SECRET=changeme_session_secret_minimum_64_characters_random_string_here

# Session lifetime in seconds (1800 = 30 minutes)
SESSION_LIFETIME=1800

# ========================================
# Security Settings
# ========================================
# Set to true in production
FORCE_HTTPS=false

# CSRF token timeout (seconds)
CSRF_TOKEN_TIMEOUT=3600

# ========================================
# Password Requirements
# ========================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ========================================
# Email Configuration (future use)
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@skanpolis.pl
MAIL_FROM_NAME="SkanPolis"

# ========================================
# Development Tools
# ========================================
# Enable PhpMyAdmin (dev only)
ENABLE_PHPMYADMIN=true
